# 운영 빌드 환경변수 (참고용). 실제 값은 docker-compose 의 web.build.args 로 주입된다.
# Vite 는 빌드 시점에 import.meta.env.VITE_* 를 번들에 인라인한다.

# 백엔드 베이스 URL — axios 가 자동으로 "/api/v1" 를 덧붙인다.
# 동일 출처(nginx 가 /api/v1 프록시)이므로 공인 IP(또는 도메인)만 적는다. 포트/경로 X.
VITE_API_URL=http://168.107.40.234

# OAuth 콜백 등에 쓰이는 프론트 공개 URL
VITE_PUBLIC_URL=http://168.107.40.234

# 데모 목세션 비활성(실제 백엔드 사용)
VITE_MOCK_SESSION=false
